# LLM Provider Configuration
LLM_PROVIDER="xai" # Opções: xai, gemini, openai
LLM_BASE_URL="https://api.xai.com/v1" # Para Gemini usar: https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY="sua_chave_aqui"
LLM_MODEL="grok-2" # Para Gemini usar: gemini-2.0-flash, para OpenAI: gpt-4o-mini

# Admin Security
ADMIN_PASSWORD="sua_senha_segura"

# Google Sheets Configuration
GOOGLE_SHEETS_CREDENTIALS_FILE="credentials.json"
GOOGLE_SHEETS_DOCUMENT_ID="id_da_planilha_aqui"
